#!/usr/bin/env bash

# Pre-push hook: blocking checks
# 1. Unit test suite (npm test) -- BLOCKS the push on failure.
#    Skipped if .test-passed already matches this commit (written by posttest).
#    DELIBERATELY the unit suite only, NOT `npm run test:all`. test:all lets the
#    integration tier see your real credentials, so every push would spawn real
#    LLM sessions and bill you -- a local gate must never cost money. The
#    integration tier is watched instead by the keyless `integration` job in
#    .github/workflows/ci.yml (free, runs on every push/PR); the paid tier is
#    the manually dispatched .github/workflows/integration-live.yml. Run
#    `npm run test:integration` yourself for the free tier -- it is ~10s.
# 2. npm audit (warn only)

# Git runs this file directly (core.hooksPath=.husky, set by
# scripts/setup-hooks.js); abort on unguarded failures, as husky's
# `sh -e` shim did before.
set -e

# Check if tests already passed for the current HEAD commit
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null)
CACHED_SHA=""
if [ -f .test-passed ]; then
  CACHED_SHA=$(cat .test-passed 2>/dev/null | tr -d '[:space:]')
fi

if [ -n "$HEAD_SHA" ] && [ "$HEAD_SHA" = "$CACHED_SHA" ]; then
  echo "Tests already passed for $HEAD_SHA — skipping."
else
  echo "Running unit test suite before push..."
  npm test || exit 1
fi

echo "Checking for dependency vulnerabilities..."
npm audit --audit-level=moderate || echo "  (npm audit warnings above - review when convenient)"
