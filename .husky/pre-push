#!/usr/bin/env bash

# Pre-push hook: blocking checks
# 1. Unit test suite (npm test) -- BLOCKS the push on failure.
#    Skipped if .test-passed already matches this commit (written by posttest).
#    NOTE: gates on the unit suite, which is green. Integration tests
#    (npm run test:all) are intentionally excluded until the "Fix integration
#    tests" task lands; switch this to `npm run test:all` once they pass.
# 2. npm audit (warn only)

# Check if tests already passed for the current HEAD commit
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null)
CACHED_SHA=""
if [ -f .test-passed ]; then
  CACHED_SHA=$(cat .test-passed 2>/dev/null | tr -d '[:space:]')
fi

if [ -n "$HEAD_SHA" ] && [ "$HEAD_SHA" = "$CACHED_SHA" ]; then
  echo "Tests already passed for $HEAD_SHA — skipping."
else
  echo "Running unit test suite before push..."
  npm test || exit 1
fi

echo "Checking for dependency vulnerabilities..."
npm audit --audit-level=moderate || echo "  (npm audit warnings above - review when convenient)"
