#!/usr/bin/env bash

# Pre-commit hook: fast checks (<2s)
# 1. lint-staged (ESLint on staged .js files)
# 2. Secret detection
# 3. File size enforcement
# 4. Cross-file citation freshness (staged files + everything citing them)
# 5. Auto-regenerate doc sections (auto-stages CLAUDE.md if changed)
# 6. CLAUDE.md drift warning

# Git runs this file directly (core.hooksPath=.husky, set by
# scripts/setup-hooks.js); abort on the first failing check, as husky's
# `sh -e` shim did before.
set -e

# lint-staged's stash-backup step resolves refs/stash, which dies with
# "fatal: Needed a single revision" whenever that ref does not exist. Linked
# worktrees hit it (they share the stash namespace with the main repo), but so
# does ANY clone that has never stashed -- e.g. a fresh contributor whose first
# commit precedes their first `git stash`. Gate on the real condition (missing
# refs/stash), not just the worktree case, or the hook is broken out of the box.
# --no-stash skips the backup (safety only; eslint --fix is idempotent).
# --no-stash skips lint-staged's stash backup; eslint --fix may then touch
# unstaged hunks of partially-staged files in the working tree (never the
# commit). Acceptable for this repo's style-only fix rules.
if git rev-parse --git-dir | grep -q 'worktrees' || ! git rev-parse --verify --quiet refs/stash >/dev/null 2>&1; then
  npx lint-staged --no-stash
else
  npx lint-staged
fi

node scripts/check-secrets.js
node scripts/check-file-sizes.js
node scripts/check-citations.js
node scripts/generate-docs.js
node scripts/validate-docs.js
