#!/usr/bin/env bash

# Pre-commit hook: fast checks (<2s)
# 1. lint-staged (ESLint on staged .js files)
# 2. Secret detection
# 3. File size enforcement
# 4. Auto-regenerate doc sections (auto-stages CLAUDE.md if changed)
# 5. CLAUDE.md drift warning

# Git runs this file directly (core.hooksPath=.husky, set by
# scripts/setup-hooks.js); abort on the first failing check, as husky's
# `sh -e` shim did before.
set -e

# In linked git worktrees, lint-staged's stash-backup step fails because
# the worktree shares the stash ref namespace with the main repo but the
# resolution path breaks when no stash exists. Use --no-stash to skip
# the backup (the backup is for safety only; eslint --fix is idempotent).
# --no-stash skips lint-staged's stash backup; eslint --fix may then touch
# unstaged hunks of partially-staged files in the working tree (never the
# commit). Acceptable for this repo's style-only fix rules.
if git rev-parse --git-dir | grep -q 'worktrees'; then
  npx lint-staged --no-stash
else
  npx lint-staged
fi

node scripts/check-secrets.js
node scripts/check-file-sizes.js
node scripts/generate-docs.js
node scripts/validate-docs.js
