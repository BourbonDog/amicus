# Dependencies
node_modules/

# Build output
dist/
build/

# Coverage
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# OpenCode config (may contain API keys)
opencode.json

# Test artifacts
*.tmp
*.temp
.test-passed

# E2E screenshots (generated during test runs)
tests/screenshots/*
!tests/screenshots/.gitkeep

# Package lock (optional - some prefer to commit it)
# package-lock.json

# Amicus session data (user-specific; glob also covers pre-rebrand sidecar_sessions/)
.claude/*_sessions/

# Claude Code local settings (personal permission grants)
.claude/settings.local.json

# Local dev-server launch config (machine-specific absolute paths)
.claude/launch.json

# Agent instruction files (local development only)
CLAUDE.md
GEMINI.md
AGENTS.md

# Archived docs (stale/superseded, kept locally for reference)
docs/archive/

# Design docs and plans (local only)
docs/plans/

# Eval workspace (generated during eval runs)
evals/workspace/

# Test output logs (Jest redirects; scratch only)
test_output*.txt
*.jestlog

# Council run folders (raw model output + briefings; may embed the source under review).
# Root-anchored deliberately: an unanchored `second-opinion/` would also match
# skills/second-opinion/ and silently ignore the shipped skill files.
/output/
/second-opinion/

# Graphify knowledge graph -- generated build artifact, ~8 MB.
# `npm run graphify:index` rebuilds it from scratch: ~24 min and ~1.7M input tokens via
# claude-cli, and it regenerates only graph.json (GRAPH_REPORT.md and graph.html come back
# on the next incremental rebuild). Deleting this directory is not free.
graphify-out/

# Probe 3 (#202 Lever 2) raw wire capture -- `scripts/probe-provider-routing.js`'s default
# --out, ~1.4 MB because every captured body carries the engine's whole system prompt and
# tool schemas. Regenerable in ~4 minutes by the script itself. Root-anchored and named
# exactly, NOT `probe-3/`: the few-KB `probe-3/wire-capture-digest.json` beside it is the
# committed record and must stay tracked.
/probe-3/wire-capture.json
