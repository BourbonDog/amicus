# Amicus Environment Configuration
# Copy this file to ~/.config/amicus/.env (or run `amicus setup` — it writes this for you).
# Legacy SIDECAR_* names still work (one-time deprecation warning).

# =============================================================================
# API Keys
# =============================================================================
# Get your OpenRouter key at: https://openrouter.ai/settings/keys
# OpenRouter gives access to all providers from a single key.
# Add direct-provider keys below if you prefer billing through them directly.

OPENROUTER_API_KEY=your-openrouter-api-key-here

# Direct Google access (uses GOOGLE_GENERATIVE_AI_API_KEY prefix: google/...)
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-key-here

# Direct OpenAI access (openai/... prefix)
# OPENAI_API_KEY=your-openai-key-here

# Direct Anthropic access (anthropic/... prefix)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Direct DeepSeek access
# DEEPSEEK_API_KEY=your-deepseek-key-here

# =============================================================================
# Default Model
# =============================================================================
# Run `amicus models` to browse the live catalog, then set an alias or full ID.
# Examples: use an alias (gemini, opus, deepseek — run 'amicus models' to browse)
#   or a full id like openrouter/google/gemini-3.1-flash-lite-preview
# This is written by `amicus setup` — prefer the wizard over hand-editing.
# AMICUS_DEFAULT_MODEL is NOT a real env var; set your default via `amicus setup`.

# =============================================================================
# Logging
# =============================================================================

# Log level: error | warn | info | debug (default: error)
# - error: Only errors (default — keeps stderr clean for LLM consumption)
# - warn:  Errors and warnings
# - info:  Errors, warnings, and operational info
# - debug: All logs including verbose poll/server output
# LOG_LEVEL=error

# =============================================================================
# Config and Key File Paths
# =============================================================================

# Override the entire config directory (keys, catalog, session index).
# Default: ~/.config/amicus
# AMICUS_CONFIG_DIR=/path/to/config

# Override just the .env file directory (keys only).
# AMICUS_ENV_DIR wins over the legacy SIDECAR_ENV_DIR if both are set.
# Default: ~/.config/amicus
# AMICUS_ENV_DIR=/path/to/env

# =============================================================================
# Advanced / Debug
# =============================================================================

# Chrome DevTools Protocol debug port for Electron UI testing (default: 9222)
# Increment to avoid conflicts with a running Chrome browser.
# AMICUS_DEBUG_PORT=9223

# Mock update state for UI development: available | updating | success | error
# Has no effect outside local development.
# AMICUS_MOCK_UPDATE=available

# =============================================================================
# Headless Tuning (advanced)
# =============================================================================
# These are rarely needed. The defaults work for almost all workloads.

# Delay between poll cycles in milliseconds (default: 2000)
# AMICUS_POLL_INTERVAL_MS=2000

# Per-poll getMessages call timeout in milliseconds (default: 30000)
# AMICUS_POLL_CALL_TIMEOUT_MS=30000

# Stable polls required after SDK reports session complete (default: 2)
# AMICUS_STABLE_FINISHED_POLLS=2

# Stable polls required with no completion signal, ~60s at 2s interval (default: 30)
# AMICUS_STABLE_IDLE_POLLS=30

# Consecutive poll failures before bailing, ~30s at 2s interval (default: 15)
# AMICUS_MAX_CONSECUTIVE_POLL_FAILURES=15

# Max legs in a single fanout wave; non-positive falls back to default (default: 10)
# AMICUS_FANOUT_MAX_LEGS=10

# Max milliseconds to wait for the Electron UI to load (default: 15000)
# AMICUS_GUI_LOAD_TIMEOUT_MS=15000

# =============================================================================
# Idle Self-Termination (legacy env names — AMICUS_IDLE_TIMEOUT_* migration pending)
# =============================================================================
# Values in minutes; 0 = disabled.

# Blanket override for all modes (recommended for amicus)
# SIDECAR_IDLE_TIMEOUT=0

# Per-mode overrides (take priority over blanket)
# SIDECAR_IDLE_TIMEOUT_HEADLESS=15
# SIDECAR_IDLE_TIMEOUT_INTERACTIVE=60
# SIDECAR_IDLE_TIMEOUT_SERVER=30
