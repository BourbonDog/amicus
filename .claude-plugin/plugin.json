{
  "name": "amicus",
  "version": "4.16.1",
  "description": "Multi-model council for Claude: models from different families review your work or do a task, judge each other blind, and a chair writes the verdict. Or fork a conversation to any model and fold it back.",
  "author": {
    "name": "Christian Wagner"
  },
  "homepage": "https://bourbondog.github.io/amicus/",
  "repository": "https://github.com/BourbonDog/amicus",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "multi-model",
    "llm",
    "council",
    "second-opinion",
    "sidecar",
    "gemini",
    "gpt",
    "deepseek"
  ],
  "skills": [
    "./skills/sidecar",
    "./skills/second-opinion"
  ],
  "mcpServers": {
    "amicus": {
      "command": "npx",
      "args": [
        "-y",
        "amicus@latest",
        "mcp"
      ],
      "env": {
        "AMICUS_SKIP_POSTINSTALL": "1"
      }
    }
  }
}
